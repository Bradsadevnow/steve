
.mt-node { margin:0; padding:0; border-width:0; border-radius:0; flex-shrink:0; }
.mt-button { background-color:rgba(0,0,0,0); -unity-background-image-tint-color:white; }
.mt-button:hover { opacity:0.9; }
.mt-button:active { opacity:0.7; }
.mt-button:focus { border-width:2px; border-color:rgb(224,188,113); }
.mt-button:disabled { opacity:0.4; }
.mt-input .unity-text-field__input { background-color:rgba(0,0,0,0); background-image:none; border-width:0; color:rgb(233,219,190); -unity-text-align:middle-left; }
