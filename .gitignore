# Steve source only; private state and independent projects remain local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CREDITS.md
!/AGENTS.md
!/PROJECT_BOUNDARIES.md
!/docs/
!/Tools/
!/t-scan/
!/TScanViewer/

/t-scan/*
!/t-scan/README.md
!/t-scan/Start-Steve.ps1
!/t-scan/live/
!/t-scan/art/

/TScanViewer/*
!/TScanViewer/README.md
!/TScanViewer/Assets/
!/TScanViewer/Packages/
!/TScanViewer/ProjectSettings/

__pycache__/
*.py[cod]
*.log
*.tmp
.env
.env.*
!.env.example
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.blend[0-9]

# Local capture scratch and optional source artwork; retain on disk, not in Git.
/TScanViewer/Assets/Temp/
/TScanViewer/Assets/Temp.meta
/TScanViewer/Assets/Fantasy RPG UI Pack/PSD/
/TScanViewer/Assets/Fantasy RPG UI Pack/PSD.meta
